# ── 기본 ─────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/aramcrm"
AUTH_SECRET="랜덤 문자열"
NEXTAUTH_URL="http://localhost:3000"

# ── 아람 AI (요약·분석·명함 인식·이메일 작성) ───────────
ANTHROPIC_API_KEY=""
# 기본값 claude-opus-5-5
# ARAM_AI_MODEL="claude-opus-5-5"

# ── 아람 서버 음성 전사 (둘 중 하나 이상 권장) ──────────
# Deepgram: 화자 분리 + 다국어 자동 감지(코드 스위칭) 지원 → 권장
DEEPGRAM_API_KEY=""
# DEEPGRAM_MODEL="nova-3"
# OpenAI Whisper: 99개 언어 전사 (화자 분리는 AI 추정)
OPENAI_API_KEY=""
# OPENAI_STT_MODEL="whisper-1"

# 녹음/명함 이미지 비공개 저장 위치 (기본: ./storage/aram, 영구 볼륨 권장)
# ARAM_STORAGE_DIR="/data/aram"

# ── 리마인더 크론 ───────────────────────────────────
# GET /api/aram/cron/reminders  (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=""
# 리마인더 메일 발송 끄기: ARAM_REMINDER_EMAIL=false

# ── 메일 발송 (후속 이메일·리마인더) ─────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
